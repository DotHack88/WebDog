# ============================================================
# WebDog — Environment Variables (ESEMPIO)
# ============================================================
# Copia questo file in .env e compila i valori reali.
# NON committare mai il file .env.
# ============================================================

# Firebase Realtime Database
# Ottienili su https://console.firebase.google.com/ → Impostazioni progetto → App web
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your_project-default-rtdb.europe-west1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxxxxxx

# EmailJS
# Ottienili su https://www.emailjs.com/ → Account → API Keys
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Email amministratore dove ricevere le notifiche
VITE_ADMIN_EMAIL=your_admin@email.com

# Admin UID — il tuo UID Firebase Auth (vedi README)
VITE_ADMIN_UID=

# Google Analytics 4 Measurement ID
# Ottienilo su analytics.google.com → Proprietà → Flussi dati
VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
